<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.quiz.quizera.controllers.StudentController">
    <top>
        <HBox alignment="CENTER_LEFT" spacing="10" style="-fx-background-color: #27ae60; -fx-padding: 15;">
            <Label fx:id="welcomeLabel" style="-fx-font-size: 20px; -fx-text-fill: white; -fx-font-weight: bold;" HBox.hgrow="ALWAYS"/>
            <Button text="Logout" onAction="#handleLogout" style="-fx-background-color: #c0392b; -fx-text-fill: white;"/>
        </HBox>
    </top>

    <center>
        <VBox alignment="CENTER" spacing="30.0" style="-fx-background-color: #ecf0f1;">
            <padding>
                <Insets bottom="40.0" left="40.0" right="40.0" top="40.0"/>
            </padding>

            <Label text="Student Dashboard" style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>

            <VBox spacing="20" alignment="CENTER">
                <Button text="View Profile" onAction="#handleViewProfile" maxWidth="300" prefHeight="50" style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-font-size: 16px;"/>
                <Button text="Start Quiz" onAction="#handleViewCourses" maxWidth="300" prefHeight="50" style="-fx-background-color: #9b59b6; -fx-text-fill: white; -fx-font-size: 16px;"/>
                <Button text="View Grades" onAction="#handleViewGrades" maxWidth="300" prefHeight="50" style="-fx-background-color: #e67e22; -fx-text-fill: white; -fx-font-size: 16px;"/>
                <Button text="Attempt History" onAction="#handleViewHistory" maxWidth="300" prefHeight="50" style="-fx-background-color: #16a085; -fx-text-fill: white; -fx-font-size: 16px;"/>
            </VBox>
        </VBox>
    </center>
</BorderPane>

