<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox alignment="CENTER" spacing="20.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" 
      fx:controller="com.quiz.quizera.controllers.RegisterController"
      style="-fx-background-color: linear-gradient(to bottom, #f093fb 0%, #f5576c 100%);">
    <padding>
        <Insets bottom="30.0" left="40.0" right="40.0" top="30.0"/>
    </padding>

    <VBox alignment="CENTER" spacing="20" style="-fx-background-color: white; -fx-background-radius: 15; -fx-padding: 35;">
        <Label text="📝 Create Account" style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-text-fill: #f5576c;"/>
        <Label text="Join Quizera today!" style="-fx-font-size: 14px; -fx-text-fill: #888;"/>

        <VBox spacing="12" alignment="CENTER">
            <VBox spacing="5">
                <Label text="Username" style="-fx-font-size: 13px; -fx-text-fill: #333; -fx-font-weight: bold;"/>
                <TextField fx:id="usernameField" promptText="Choose a username" 
                          prefWidth="300" prefHeight="38" 
                          style="-fx-background-radius: 5; -fx-border-color: #ddd; -fx-border-radius: 5;"/>
            </VBox>

            <VBox spacing="5">
                <Label text="Email" style="-fx-font-size: 13px; -fx-text-fill: #333; -fx-font-weight: bold;"/>
                <TextField fx:id="emailField" promptText="your.email@example.com" 
                          prefWidth="300" prefHeight="38" 
                          style="-fx-background-radius: 5; -fx-border-color: #ddd; -fx-border-radius: 5;"/>
            </VBox>

            <VBox spacing="5">
                <Label text="Password" style="-fx-font-size: 13px; -fx-text-fill: #333; -fx-font-weight: bold;"/>
                <PasswordField fx:id="passwordField" promptText="Create a strong password" 
                              prefWidth="300" prefHeight="38" 
                              style="-fx-background-radius: 5; -fx-border-color: #ddd; -fx-border-radius: 5;"/>
            </VBox>

            <VBox spacing="5">
                <Label text="Confirm Password" style="-fx-font-size: 13px; -fx-text-fill: #333; -fx-font-weight: bold;"/>
                <PasswordField fx:id="confirmPasswordField" promptText="Re-enter your password" 
                              prefWidth="300" prefHeight="38" 
                              style="-fx-background-radius: 5; -fx-border-color: #ddd; -fx-border-radius: 5;"/>
            </VBox>

            <VBox spacing="5">
                <Label text="Role" style="-fx-font-size: 13px; -fx-text-fill: #333; -fx-font-weight: bold;"/>
                <ComboBox fx:id="roleComboBox" promptText="Select your role" 
                         prefWidth="300" prefHeight="38"
                         style="-fx-background-radius: 5;"/>
            </VBox>
        </VBox>

        <Button text="Create Account" onAction="#handleRegister" prefWidth="300" prefHeight="42"
                style="-fx-background-color: #f5576c; -fx-text-fill: white; -fx-font-size: 16px; -fx-font-weight: bold; -fx-background-radius: 5;"/>
        
        <Separator prefWidth="300"/>
        
        <HBox alignment="CENTER" spacing="5">
            <Label text="Already have an account?" style="-fx-text-fill: #666;"/>
            <Button text="Login here" onAction="#switchToLogin" 
                   style="-fx-background-color: transparent; -fx-text-fill: #f5576c; -fx-underline: true; -fx-cursor: hand;"/>
        </HBox>

        <Label fx:id="messageLabel" style="-fx-text-fill: #e74c3c; -fx-font-size: 13px; -fx-font-weight: bold;"/>
    </VBox>
</VBox>
