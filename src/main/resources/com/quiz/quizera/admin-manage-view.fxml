<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.quiz.quizera.controllers.AdminManageController">
    <top>
        <HBox spacing="10" style="-fx-background-color: #34495e; -fx-padding: 10;">
            <Label text="Quiz Management" style="-fx-text-fill: white; -fx-font-size: 18px; -fx-font-weight: bold;"/>
            <Button text="Back" onAction="#handleBack" style="-fx-background-color: #95a5a6; -fx-text-fill: white;"/>
        </HBox>
    </top>
    <center>
        <TabPane>
            <tabs>
                <Tab text="Categories">
                    <VBox spacing="10" style="-fx-padding: 10;">
                        <HBox spacing="10">
                            <TextField fx:id="categoryNameField" promptText="Category name"/>
                            <Button text="Add" onAction="#handleAddCategory"/>
                            <Button text="Rename Selected" onAction="#handleRenameCategory"/>
                            <Button text="Delete Selected" onAction="#handleDeleteCategory"/>
                        </HBox>
                        <TableView fx:id="categoryTable">
                            <columns>
                                <TableColumn fx:id="catIdCol" text="ID" prefWidth="80"/>
                                <TableColumn fx:id="catNameCol" text="Name" prefWidth="240"/>
                            </columns>
                        </TableView>
                    </VBox>
                </Tab>
                <Tab text="Questions">
                    <VBox spacing="10" style="-fx-padding: 10;">
                        <HBox spacing="10">
                            <ComboBox fx:id="questionCategoryCombo" promptText="Category"/>
                            <ComboBox fx:id="difficultyCombo" promptText="Difficulty"/>
                        </HBox>
                        <TextArea fx:id="questionTextArea" promptText="Question text" prefRowCount="3"/>
                        <GridPane hgap="10" vgap="10">
                            <columnConstraints>
                                <ColumnConstraints percentWidth="10"/>
                                <ColumnConstraints percentWidth="40"/>
                                <ColumnConstraints percentWidth="10"/>
                                <ColumnConstraints percentWidth="40"/>
                            </columnConstraints>
                            <children>
                                <Label text="A:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                                <TextField fx:id="optA" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
                                <Label text="B:" GridPane.rowIndex="0" GridPane.columnIndex="2"/>
                                <TextField fx:id="optB" GridPane.rowIndex="0" GridPane.columnIndex="3"/>
                                <Label text="C:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                                <TextField fx:id="optC" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
                                <Label text="D:" GridPane.rowIndex="1" GridPane.columnIndex="2"/>
                                <TextField fx:id="optD" GridPane.rowIndex="1" GridPane.columnIndex="3"/>
                            </children>
                        </GridPane>
                        <HBox spacing="10">
                            <Label text="Correct:"/>
                            <ComboBox fx:id="correctCombo" promptText="A/B/C/D"/>
                            <Button text="Add Question" onAction="#handleAddQuestion"/>
                            <Button text="Update Selected" onAction="#handleUpdateQuestion"/>
                            <Button text="Delete Selected" onAction="#handleDeleteQuestion"/>
                        </HBox>
                        <TableView fx:id="questionTable">
                            <columns>
                                <TableColumn fx:id="qIdCol" text="ID" prefWidth="60"/>
                                <TableColumn fx:id="qCatCol" text="Category" prefWidth="120"/>
                                <TableColumn fx:id="qDiffCol" text="Difficulty" prefWidth="100"/>
                                <TableColumn fx:id="qTextCol" text="Question" prefWidth="400"/>
                            </columns>
                        </TableView>
                        <Label fx:id="messageLabel" style="-fx-text-fill: #e74c3c;"/>
                    </VBox>
                </Tab>
            </tabs>
        </TabPane>
    </center>
</BorderPane>
