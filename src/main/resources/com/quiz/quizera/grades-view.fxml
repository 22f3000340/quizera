<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox alignment="CENTER_LEFT" spacing="10.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.quiz.quizera.controllers.GradesController" style="-fx-padding: 20;">
    <Label text="Grades" style="-fx-font-size: 20px; -fx-font-weight: bold;"/>
    <TableView fx:id="table">
        <columns>
            <TableColumn fx:id="colCategory" text="Category" prefWidth="180"/>
            <TableColumn fx:id="colDifficulty" text="Difficulty" prefWidth="120"/>
            <TableColumn fx:id="colScore" text="Score" prefWidth="100"/>
            <TableColumn fx:id="colDate" text="Date" prefWidth="200"/>
        </columns>
    </TableView>
    <Button text="Back" onAction="#handleBack"/>
</VBox>
