<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox alignment="CENTER" spacing="20.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" 
      fx:controller="com.quiz.quizera.controllers.LoginController" 
      style="-fx-background-color: linear-gradient(to bottom, #667eea 0%, #764ba2 100%);">
    <padding>
        <Insets bottom="40.0" left="40.0" right="40.0" top="40.0"/>
    </padding>

    <VBox alignment="CENTER" spacing="25" style="-fx-background-color: white; -fx-background-radius: 15; -fx-padding: 40;">
        <Label text="🎓 Quizera" style="-fx-font-size: 36px; -fx-font-weight: bold; -fx-text-fill: #667eea;"/>
        <Label text="Login to your account" style="-fx-font-size: 16px; -fx-text-fill: #888;"/>

        <VBox spacing="15" alignment="CENTER">
            <VBox spacing="5">
                <Label text="Username" style="-fx-font-size: 14px; -fx-text-fill: #333;"/>
                <TextField fx:id="usernameField" promptText="Enter your username" 
                          prefWidth="300" prefHeight="40" 
                          style="-fx-background-radius: 5; -fx-border-color: #ddd; -fx-border-radius: 5;"/>
            </VBox>

            <VBox spacing="5">
                <Label text="Password" style="-fx-font-size: 14px; -fx-text-fill: #333;"/>
                <PasswordField fx:id="passwordField" promptText="Enter your password" 
                              prefWidth="300" prefHeight="40" 
                              style="-fx-background-radius: 5; -fx-border-color: #ddd; -fx-border-radius: 5;"/>
            </VBox>
        </VBox>

        <Button text="Login" onAction="#handleLogin" prefWidth="300" prefHeight="45"
                style="-fx-background-color: #667eea; -fx-text-fill: white; -fx-font-size: 16px; -fx-font-weight: bold; -fx-background-radius: 5;"/>
        
        <Separator prefWidth="300"/>
        
        <HBox alignment="CENTER" spacing="5">
            <Label text="Don't have an account?" style="-fx-text-fill: #666;"/>
            <Button text="Register here" onAction="#switchToRegister" 
                   style="-fx-background-color: transparent; -fx-text-fill: #667eea; -fx-underline: true; -fx-cursor: hand;"/>
        </HBox>

        <Label fx:id="messageLabel" style="-fx-text-fill: #e74c3c; -fx-font-size: 14px;"/>
        
        <Separator prefWidth="300"/>
        <VBox spacing="5" alignment="CENTER">
            <Label text="Test Credentials:" style="-fx-font-size: 12px; -fx-text-fill: #888; -fx-font-weight: bold;"/>
            <Label text="Admin: admin / admin123" style="-fx-font-size: 11px; -fx-text-fill: #666;"/>
            <Label text="Student: student / student123" style="-fx-font-size: 11px; -fx-text-fill: #666;"/>
        </VBox>
    </VBox>
</VBox>
